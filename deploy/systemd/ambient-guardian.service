[Unit]
Description=InnerOS voice and home orchestration backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/inneros-ambient-guardian-amazon-2026
Environment=PYTHONPATH=%h/projects/inneros-ambient-guardian-amazon-2026/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOST=127.0.0.1
Environment=PORT=8794
EnvironmentFile=%h/data/ralfia/ambient_guardian/runtime.env
ExecStart=%h/projects/inneros-ambient-guardian-amazon-2026/.venv/bin/python -m ambient_guardian.official_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/data/ralfia/ambient_guardian

[Install]
WantedBy=default.target
