[Unit]
Description=Atlas fresh infrastructure reports and correlated critical alerts
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/workspaces/inneros-ambient-guardian-amazon-2026
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/workspaces/inneros-ambient-guardian-amazon-2026/src:/home/rlopez/inneros/inneros_core/platform
Environment=AMBIENT_GUARDIAN_SHARED_ENV_FILE=/home/rlopez/inneros/inneros_core/platform/.env
Environment=AMBIENT_GUARDIAN_NOTICE_INVENTORY=/home/rlopez/.config/ambient-guardian/bellini-notice-inventory.json
Environment=AMBIENT_GUARDIAN_UNIFI_RF_ALERT_LOCALE=en-US
Environment=AMBIENT_GUARDIAN_UNIFI_RF_ECHO_TARGET=notify.echo_cuarto_speak
Environment=AMBIENT_GUARDIAN_ALEXA_SPEAK_ENABLED=1
Environment=AMBIENT_GUARDIAN_ALEXA_NOTIFY_ALLOWLIST=notify.echo_cuarto_speak
Environment=AMBIENT_GUARDIAN_UNIFI_RF_MOBILE_SERVICE=mobile_app_infinix_x6873
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python -m ambient_guardian.notification_brief problems
Restart=on-failure
RestartSec=10
MemoryMax=180M
CPUQuota=10%
UMask=0077

[Install]
WantedBy=default.target
