{$ATLAS_DOMAIN} {$ATLAS_LEGACY_DOMAIN} {
    @legacy not host {$ATLAS_DOMAIN}
    redir @legacy https://{$ATLAS_DOMAIN}{uri} 308
    encode zstd gzip
    request_body {
        max_size 128KB
    }
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-store
    }
    reverse_proxy core:8080
}
