[Unit]
Description=Atlas owner-approved UniFi 03 width correction executor
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/workspaces/inneros-ambient-guardian-amazon-2026
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/workspaces/inneros-ambient-guardian-amazon-2026/src:/home/rlopez/inneros/inneros_core/platform
Environment=AMBIENT_GUARDIAN_SHARED_ENV_FILE=/home/rlopez/inneros/inneros_core/platform/.env
Environment=AMBIENT_GUARDIAN_UNIFI_RADIO_ADJUST_ENABLED=1
EnvironmentFile=/home/rlopez/.config/ambient-guardian/skill-bridge.env
EnvironmentFile=/home/rlopez/.config/ambient-guardian/unifi-radio.env
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python -m ambient_guardian.radio_correction worker
Restart=on-failure
RestartSec=10
MemoryMax=150M
CPUQuota=5%
UMask=0077

[Install]
WantedBy=default.target
